<?xml version="1.0"?>
<robot name="articulated_rrr">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.15"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415" upper="3.1415" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.08"/>
      </geometry>
      <material name="red">
        <color rgba="0.85 0.15 0.15 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="red">
        <color rgba="0.85 0.15 0.15 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="0.0" effort="10" velocity="3"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.06"/>
      </geometry>
      <material name="green">
        <color rgba="0.15 0.7 0.25 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.15 0.7 0.25 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.966" upper="2.966" effort="10" velocity="3"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.35 0.85 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.03"/>
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.35 0.85 1"/>
      </material>
    </visual>
  </link>

  <joint name="ee_fixed_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee_link"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>

  <link name="ee_link"/>

</robot>
